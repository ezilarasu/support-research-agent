# Copy to .env and fill in. Never commit .env.

# Required
GROQ_API_KEY=

# Provider: groq (default) | huggingface | hf_local
LLM_PROVIDER=groq

# Optional
HUGGINGFACEHUB_API_TOKEN=     # needed for LLM_PROVIDER=huggingface
TAVILY_API_KEY=               # live web research (research agent)
LANGSMITH_API_KEY=            # tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=support-research-agent

# Security (leave JWT_SECRET unset for open-access dev mode)
# JWT_SECRET=
